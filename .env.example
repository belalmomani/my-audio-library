# ======= تطبيق أندرويد: ضع هذه القيم في local.properties (أو كمتغيرات بيئة في CI) =======
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
BACKEND_URL=https://your-backend.example.com      # خادم FastAPI (server/)، اتركه فارغًا لتعطيل المعالجة السحابية
STARTIO_APP_ID=REPLACE_WITH_STARTIO_APP_ID        # من لوحة Start.io؛ القيمة التجريبية تعطّل الإعلانات
PRIVACY_POLICY_URL=https://example.com/privacy
# توقيع الإصدار (اختياري محليًا، مطلوب لـ Play)
KEYSTORE_PATH=
KEYSTORE_PASSWORD=
KEY_ALIAS=
KEY_PASSWORD=
# خادم المعالجة له ملف منفصل: server/.env.example
