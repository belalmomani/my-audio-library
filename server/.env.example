# ======= نسخ هذا الملف إلى .env ولا ترفعه إلى GitHub =======
# Supabase (من Project Settings > API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=PUBLIC-ANON-KEY            # يُستخدم لاستدعاءات PostgREST بتوكن المستخدم
SUPABASE_SERVICE_ROLE_KEY=SECRET-SERVICE-KEY  # سري! على الخادم فقط. مطلوب لحذف الحساب
SUPABASE_JWT_SECRET=                          # لمشاريع HS256 القديمة
SUPABASE_JWKS_URL=                            # لمشاريع المفاتيح غير المتناظرة: https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# Cloudflare R2 (S3-compatible) — أنشئ Bucket خاصًا وAPI Token بصلاحية Object Read & Write لهذا الـ Bucket فقط
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=my-audio-library

# حدود وسلوك
MAX_UPLOAD_MB=1024
MAX_AUDIO_MINUTES=240
PRESIGN_TTL_SECONDS=900
MAX_CONCURRENT_JOBS=1
WORK_DIR=/data/work
DB_PATH=/data/jobs.sqlite
JOB_TTL_HOURS=24

# المعالجة (تعطيل ما لم تثبّته)
ENABLE_ASR=true
ENABLE_DIARIZATION=false
ENABLE_SEPARATION=false
WHISPER_MODEL=large-v3          # أو medium/small للأجهزة الأضعف
WHISPER_DEVICE=auto             # cpu | cuda | auto
WHISPER_COMPUTE_TYPE=int8       # float16 على GPU
HF_TOKEN=                       # مطلوب لـ pyannote بعد قبول شروط النماذج على Hugging Face
